<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 13+ exige permiso explícito para mostrar notificaciones -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!-- Recepción de los mensajes de FCM -->
        <service
            android:name=".PushFlowMessagingService"
            android:exported="false">
            <intent-filter android:priority="-500">
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Trampolín de apertura: registra el clic y abre el destino -->
        <activity
            android:name=".NotificationOpenActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity="" />

        <!-- Botones de acción y descartes -->
        <receiver
            android:name=".NotificationActionReceiver"
            android:exported="false" />
    </application>
</manifest>
