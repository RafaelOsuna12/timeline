{
  "name": "pushflow",
  "version": "1.0.0",
  "description": "PushFlow - Self-hosted push notification platform (OneSignal-compatible) for Web Push and Android",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "worker": "node src/workers/index.js",
    "dev": "node --watch src/server.js",
    "migrate": "node src/db/migrate.js up",
    "migrate:status": "node src/db/migrate.js status",
    "seed": "node scripts/seed.js",
    "vapid": "node scripts/generate-vapid.js",
    "create-admin": "node scripts/create-admin.js",
    "test": "node --test tests/unit.test.js",
    "test:integration": "node tests/integration.mjs",
    "test:e2e": "node tests/e2e-send.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^10.0.2",
    "@fastify/formbody": "^8.0.2",
    "@fastify/rate-limit": "^10.2.2",
    "@fastify/static": "^8.0.4",
    "fastify": "^5.2.1",
    "pg": "^8.13.1",
    "web-push": "^3.6.7"
  },
  "license": "MIT"
}
