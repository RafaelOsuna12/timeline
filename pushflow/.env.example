# ---------------------------------------------------------------------------
# PushFlow — configuración
# Copia este fichero a `.env` y ajusta los valores.
# ---------------------------------------------------------------------------

NODE_ENV=production
HOST=0.0.0.0
PORT=3000

# URL pública con la que los navegadores y la APK llegan al servidor.
# DEBE ser https en producción (el Web Push lo exige).
PUBLIC_URL=https://push.tudominio.com

# --- Base de datos (PostgreSQL 16) -----------------------------------------
DATABASE_URL=postgres://pushflow:CAMBIA_ESTA_CLAVE@127.0.0.1:5432/pushflow
PG_POOL_MAX=12

# --- Seguridad --------------------------------------------------------------
# Clave maestra: firma las cookies y cifra las credenciales de FCM.
# Genérala con:  openssl rand -base64 48
APP_SECRET=CAMBIA_ESTO_POR_UNA_CADENA_ALEATORIA_LARGA

SESSION_TTL_HOURS=720
API_RATE_LIMIT=600
PUBLIC_RATE_LIMIT=120
CORS_ORIGINS=*
TRUST_PROXY=true

# --- Worker de envío --------------------------------------------------------
WORKER_CONCURRENCY=4
WORKER_BATCH_SIZE=500
SEND_CONCURRENCY=50

# Pon `true` para ejecutar el worker dentro del propio servidor web
# (recomendado solo en VPS pequeños con poco volumen).
WORKER_INLINE=false

# --- Notificaciones ---------------------------------------------------------
VAPID_SUBJECT=mailto:admin@tudominio.com
WEB_PUSH_TIMEOUT=10000
FCM_TIMEOUT=10000

# --- Retención de datos -----------------------------------------------------
RETENTION_EVENTS_MONTHS=13
RETENTION_JOBS_DAYS=7

# --- Geolocalización (cabeceras que añade el proxy inverso) -----------------
GEO_COUNTRY_HEADER=cf-ipcountry
GEO_CITY_HEADER=cf-ipcity

LOG_LEVEL=info
