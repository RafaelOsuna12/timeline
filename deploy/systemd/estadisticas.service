# ---------------------------------------------------------------------------
# Servicio del backend de estadisticas.honorlab.dev
#
#   sudo cp deploy/systemd/estadisticas.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now estadisticas
#   sudo systemctl status estadisticas
#   journalctl -u estadisticas -f      # ver los registros en vivo
# ---------------------------------------------------------------------------
[Unit]
Description=Estadisticas de avance de ventas (estadisticas.honorlab.dev)
Documentation=https://estadisticas.honorlab.dev
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=estadisticas
Group=estadisticas
WorkingDirectory=/opt/estadisticas/server
Environment=NODE_ENV=production
EnvironmentFile=/opt/estadisticas/server/.env
# --max-old-space-size acota el monton de V8 por debajo de MemoryMax. Sin el,
# V8 dimensiona su limite segun la RAM total de la maquina, ignora el tope del
# cgroup y systemd acaba matando el proceso en mitad del parseo del libro.
ExecStart=/usr/bin/node --max-old-space-size=768 src/index.js
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=estadisticas

# --- Endurecimiento -------------------------------------------------------
# El proceso solo necesita escribir en su directorio de datos.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/estadisticas
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
RestrictRealtime=true
RemoveIPC=true

# El parseo del libro es lo unico intensivo en memoria: llega a unos 320 MB de
# RSS durante unos segundos. El tope deja margen amplio sobre ese pico.
MemoryMax=1200M
MemoryHigh=900M

[Install]
WantedBy=multi-user.target
