# ---------------------------------------------------------------------------
# Configuracion del servidor de estadisticas.honorlab.dev
# Copia este archivo como .env y ajusta los valores.
# ---------------------------------------------------------------------------

NODE_ENV=production

# El proceso escucha solo en localhost; nginx termina el TLS y hace de proxy.
HOST=127.0.0.1
PORT=4000
TRUST_PROXY=true
PUBLIC_URL=https://estadisticas.honorlab.dev

# Secreto para firmar las sesiones. OBLIGATORIO en produccion.
# Generalo con: openssl rand -hex 48
JWT_SECRET=
JWT_EXPIRES_IN=12h

# Almacenamiento (base SQLite + archivos de Excel originales)
DATA_DIR=/var/lib/estadisticas
KEEP_SOURCE_FILES=true

# Limite de carga del archivo mensual
MAX_UPLOAD_MB=80

# Administrador inicial: solo se crea si la base no tiene usuarios.
# Usa una contrasena larga y cambiala tras el primer acceso.
ADMIN_USERNAME=admin
ADMIN_NAME=Administrador
ADMIN_PASSWORD=

# Solo si el frontend se sirve desde otro dominio (normalmente no hace falta).
# CORS_ORIGINS=https://estadisticas.honorlab.dev
